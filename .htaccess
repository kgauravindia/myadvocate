# .htaccess - My Advocate URL Routing (Universal: Offline & Online https://myadv.in)
RewriteEngine On

# 1. Force HTTPS on Live Server (myadv.in) while preserving Localhost / Offline HTTP
RewriteCond %{HTTP_HOST} ^(www\.)?myadv\.in$ [NC]
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Prevent Directory Listing
Options -Indexes

# 3. Explicitly pass-through external app folders
RewriteRule ^(opex|ais|app|upload|assets|admin)(/.*)?$ - [L]

# 4. If requested file or directory exists physically, serve directly
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 5. Profile Routing with handle or public URL (e.g. /@kumargaurav or /profile/kumargaurav)
RewriteRule ^@([a-zA-Z0-9_.-]+)/?$ profile.php?url=$1 [QSA,L]
RewriteRule ^profile/([a-zA-Z0-9_.-]+)/?$ profile.php?url=$1 [QSA,L]

# 6. Acts Routing (e.g. /acts/bns or /acts/45)
RewriteRule ^acts/([a-zA-Z0-9_-]+)/?$ act-details.php?id=$1 [QSA,L]

# 7. Clean URL to PHP file mapping (e.g. /about -> about.php, /login -> login.php)
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [QSA,L]

# 8. Legal & Info Aliases
RewriteRule ^privacy/?$ privacy-policy.php [QSA,L]
RewriteRule ^terms-and-conditions/?$ terms.php [QSA,L]
RewriteRule ^refund-policy/?$ refund-policy.php [QSA,L]
RewriteRule ^mission-and-vision/?$ mission-vision.php [QSA,L]
RewriteRule ^mission/?$ mission-vision.php [QSA,L]
RewriteRule ^vision/?$ mission-vision.php [QSA,L]

# 9. Search & Bare Acts Aliases
RewriteRule ^advocates/?$ advocate-search-result.php [QSA,L]
RewriteRule ^bare-acts/?$ acts.php [QSA,L]
RewriteRule ^search/?$ advocate-search-result.php [QSA,L]
RewriteRule ^search-by-year/?$ advocate-search-result-by-year.php [QSA,L]
RewriteRule ^search-by-mobile/?$ advocate-search-result-by-mobile.php [QSA,L]

# 10. Fallback 404 Error Document
ErrorDocument 404 /404.php
